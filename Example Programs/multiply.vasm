load R0, 0      ; result
load R1, 10     ; multiplicand
load R2, 2      ; multiplier
load R3, 4      ; jump distance
load R4, 1      ; decrement amount

plus R0, R1     ; add multiplicand
take R2, R4     ; decrement multiplier
jump R3, R2     ; loop until R2 == 0

keep R0         ; output final result
halt