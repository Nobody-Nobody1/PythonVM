; lib.vasm
; a library file to copy and paste premade code segments for syscalls, etc

; Adding to string buffer
load R0, 65 ; ASCII A
load R254, 1 ; syscall: add to buffer
load R253, 0 ; argument: register index
load R255, 1   ; trigger os logic

; Printing the string buffer
load R254, 2 ; syscall: print buffer
load R255, 1   ; trigger os logic

; Getting user input of a value
load R0, 0
load R254, 3 ; syscall: get user input
load R253, 0 ; argument: register index
load R255, 1   ; trigger os logic

; add pixel to buffer
load R251, 0   ; argument: X coordinate
load R250, 127 ; argument: Y coordinate
load R249, 1   ; argument: color value
load R254, 4   ; syscall: add to pixel buffer
load R255, 1   ; trigger os logic

; send buffer
load R254, 5 ; syscall: add to pixel buffer
load R255, 1   ; trigger os logic

; filling the screen in a specific size from any coordinate as long as R251+R0=127 or R250+R2=127
; currently creates a cool diagonal instead of filling the screen properly but its fine for now
; initial setup
load R0, 127   ; loop counter vertically
load R1, -7 ; backward jump for vertically
load R2, 127      ; loop counter horizontally
load R3, -4     ; backward jump for horizontally
load R4, 1   ; amount to decrement or increment by

; syscall arguments
load R251, 0   ; argument: X coordinate
load R250, 0   ; argument: Y coordinate
load R249, 127   ; argument: color value

; add pixel to buffer according to R0 and R2
load R254, 4   ; syscall: add to pixel buffer
load R255, 1   ; trigger os logic
plus R251, R4  ; add to X coordinate after adding earlier coordinates
take R2, R4    ; take away from counter horizontally
jump R3, R2    ; jump back while R2>0

load R2, 127      ; loop counter horizontally reset
plus R250, R4    ; change to the next Y coordinate to do the same loop again
take R0, R4      ; take away from counter vertically
jump R1, R0    ; jump back while R0>0

; send buffer
load R254, 5 ; syscall: add to pixel buffer
load R255, 1 ; trigger os logic
halt