load R0, 10     ; initial value
load R1, 20     ; increment
load R2, 5      ; loop counter
load R3, -4     ; backward jump (4 instructions)
load R4, 1      ; subtraction amount

plus R0, R1     ; R0 += R1
keep R0         ; push R0 onto stack
keep R2         ; push R2 onto stack
take R2, R4     ; R2 -= 1
jump R3, R2     ; backward jump while R2 > 0
load R255, 10
halt