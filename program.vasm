load R0, 10     ; initial value
load R1, 20     ; increment
load R2, 5      ; loop counter and determines when jump should go forward
load R3, 4      ; jump amount (R3 amount)
load R4, 1      ; subtraction amount (R4 amount)

plus R0, R1     ; R0 += R1
keep R0         ; push R0 onto stack
take R2, R4      ; R2 -= 1
keep R2         ; push R2 onto stack
jump R3, R2     ; jump back R3 instructions
halt